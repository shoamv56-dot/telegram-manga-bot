MAX_CHAPTER_IMAGES=300
MAX_CHAPTERS=1000
MAX_PDF_BYTES=51380224
PDF_JPEG_QUALITY=65
PDF_MAX_WIDTH=1600
PDF_MAX_HEIGHT=2400
